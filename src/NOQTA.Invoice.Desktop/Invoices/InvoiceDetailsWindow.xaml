<Window x:Class="NOQTA.Invoice.Desktop.Invoices.InvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Details"
        Height="820"
        Width="1180"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ============================================================ -->
        <!-- Buttons -->
        <!-- ============================================================ -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="#111827"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#111827"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="16,9"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Background"
                            Value="#F3F4F6"/>
                    <Setter Property="Foreground"
                            Value="#9CA3AF"/>
                    <Setter Property="BorderBrush"
                            Value="#E5E7EB"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                    <Setter Property="Opacity"
                            Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Background"
                            Value="#F3F4F6"/>
                    <Setter Property="Foreground"
                            Value="#9CA3AF"/>
                    <Setter Property="BorderBrush"
                            Value="#E5E7EB"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                    <Setter Property="Opacity"
                            Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#B91C1C"/>
            <Setter Property="BorderBrush"
                    Value="#FCA5A5"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Background"
                            Value="#F3F4F6"/>
                    <Setter Property="Foreground"
                            Value="#9CA3AF"/>
                    <Setter Property="BorderBrush"
                            Value="#E5E7EB"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                    <Setter Property="Opacity"
                            Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- Common text styles -->
        <!-- ============================================================ -->

        <Style x:Key="SectionLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#6B7280"/>
        </Style>

        <Style x:Key="MetaLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Foreground"
                    Value="#6B7280"/>
        </Style>

        <Style x:Key="MetaValueStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <!-- ============================================================ -->
        <!-- Invoice item rows -->
        <!-- ============================================================ -->

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
        </Style>

        <Style x:Key="HiddenGridViewColumnHeaderStyle"
               TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Header -->
        <!-- ============================================================ -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Invoice Details"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,0,0,5"/>

                <TextBlock x:Name="InvoiceNumberTextBlock"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock x:Name="InvoiceTypeStatusTextBlock"
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#6B7280"/>

            </StackPanel>

            <Button x:Name="GeneratePdfButton"
                    Grid.Column="1"
                    Content="Generate PDF"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Top"
                    Click="GeneratePdfButton_Click"/>

        </Grid>

        <!-- ============================================================ -->
        <!-- Invoice / Customer information -->
        <!-- ============================================================ -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Customer -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,36,0">

                    <TextBlock Text="BILL TO"
                               Style="{StaticResource SectionLabelStyle}"/>

                    <TextBlock x:Name="CustomerNameTextBlock"
                               Margin="0,9,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="CustomerEmailTextBlock"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="CustomerAddressTextBlock"
                               Margin="0,12,0,0"
                               FontSize="13"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               LineHeight="20"/>

                </StackPanel>

                <!-- Invoice metadata -->

                <Grid Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="INVOICE INFORMATION"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Invoice number"
                               Style="{StaticResource MetaLabelStyle}"
                               Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ElementName=InvoiceNumberTextBlock, Path=Text}"
                               Style="{StaticResource MetaValueStyle}"
                               Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Created"
                               Style="{StaticResource MetaLabelStyle}"/>

                    <TextBlock x:Name="CreatedAtTextBlock"
                               Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource MetaValueStyle}"/>

                </Grid>

            </Grid>

        </Border>

        <!-- ============================================================ -->
        <!-- Items -->
        <!-- ============================================================ -->

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table heading -->

                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="22,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="DESCRIPTION"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="QTY"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Column="2"
                                   Text="UNIT PRICE"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Column="3"
                                   Text="LINE TOTAL"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                </Border>

                <ListView x:Name="ItemsListView"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.View>

                        <GridView ColumnHeaderContainerStyle="{StaticResource HiddenGridViewColumnHeaderStyle}">

                            <GridViewColumn Header="Description"
                                            Width="520"
                                            DisplayMemberBinding="{Binding Description}"/>

                            <GridViewColumn Header="Quantity"
                                            Width="90">

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>

                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0:N2}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,14,0,14"
                                                   FontSize="13"
                                                   Foreground="#374151"/>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Unit Price"
                                            Width="150">

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>

                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,14,0,14"
                                                   FontSize="13"
                                                   Foreground="#374151"/>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Line Total"
                                            Width="155">

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>

                                        <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,14,0,14"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Grid>

        </Border>

        <!-- ============================================================ -->
        <!-- Lifecycle + Totals -->
        <!-- ============================================================ -->

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Lifecycle -->

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,18,0">

                <StackPanel>

                    <TextBlock Text="INVOICE HISTORY"
                               Style="{StaticResource SectionLabelStyle}"/>

                    <TextBlock x:Name="DatesTextBlock"
                               Margin="0,12,0,0"
                               Foreground="#4B5563"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- Totals -->

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Subtotal"
                               Foreground="#6B7280"
                               Margin="0,0,24,8"/>

                    <TextBlock x:Name="SubtotalTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="Discount"
                               Foreground="#6B7280"
                               Margin="0,0,24,8"/>

                    <TextBlock x:Name="DiscountTextBlock"
                               Grid.Row="1"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="TaxLabelTextBlock"
                               Grid.Row="2"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="TaxTextBlock"
                               Grid.Row="2"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="#374151"/>

                    <Border Grid.Row="3"
                            Grid.ColumnSpan="2"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"/>

                    <TextBlock Grid.Row="4"
                               Text="TOTAL"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="TotalTextBlock"
                               Grid.Row="4"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                </Grid>

            </Border>

        </Grid>

        <!-- ============================================================ -->
        <!-- Actions -->
        <!-- ============================================================ -->

        <Border Grid.Row="8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Invoice actions"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#6B7280"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="EditDraftButton"
                            Content="Edit Draft"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="EditDraftButton_Click"/>

                    <Button x:Name="IssueInvoiceButton"
                            Content="Issue Invoice"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="IssueInvoiceButton_Click"/>

                    <Button x:Name="MarkAsSentButton"
                            Content="Mark as Sent"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="MarkAsSentButton_Click"/>

                    <Button x:Name="MarkAsPaidButton"
                            Content="Mark as Paid"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="MarkAsPaidButton_Click"/>

                    <Button x:Name="CancelInvoiceButton"
                            Content="Cancel Invoice"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="CancelInvoiceButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>