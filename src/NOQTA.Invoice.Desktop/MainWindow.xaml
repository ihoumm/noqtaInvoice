<Window x:Class="NOQTA.Invoice.Desktop.MainWindow"
        Loaded="MainWindow_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOQTA AGENCY - Invoice Management"
        Height="820"
        Width="1380"
        MinHeight="680"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- Brushes                                                   -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="SidebarBackgroundBrush"
                         Color="#111827"/>

        <SolidColorBrush x:Key="SidebarSecondaryBrush"
                         Color="#1F2937"/>

        <SolidColorBrush x:Key="SidebarTextBrush"
                         Color="#D1D5DB"/>

        <SolidColorBrush x:Key="SidebarMutedTextBrush"
                         Color="#9CA3AF"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="AccentHoverBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="PageBackgroundBrush"
                         Color="#F5F7FA"/>

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E5E7EB"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#111827"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#6B7280"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#9CA3AF"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#15803D"/>

        <SolidColorBrush x:Key="SuccessBackgroundBrush"
                         Color="#DCFCE7"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#B45309"/>

        <SolidColorBrush x:Key="WarningBackgroundBrush"
                         Color="#FEF3C7"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#B91C1C"/>

        <SolidColorBrush x:Key="DangerBackgroundBrush"
                         Color="#FEE2E2"/>

        <SolidColorBrush x:Key="InfoBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="InfoBackgroundBrush"
                         Color="#DBEAFE"/>

        <!-- ========================================================= -->
        <!-- Base Button                                               -->
        <!-- ========================================================= -->

        <Style x:Key="SidebarNavigationButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground"
                    Value="{StaticResource SidebarTextBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="14,11"/>

            <Setter Property="Margin"
                    Value="0,2"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#1F2937"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#374151"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F9FAFB"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D1D5DB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F3F4F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- KPI Card                                                  -->
        <!-- ========================================================= -->

        <Style x:Key="KpiCardBorderStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>

        <!-- ========================================================= -->
        <!-- Status Badge                                               -->
        <!-- ========================================================= -->

        <Style x:Key="InvoiceStatusBadgeStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="#F3F4F6"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

        </Style>

        <!-- ========================================================= -->
        <!-- TextBox                                                    -->
        <!-- ========================================================= -->

        <Style x:Key="SearchTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

        <!-- ========================================================= -->
        <!-- ComboBox                                                    -->
        <!-- ========================================================= -->

        <Style x:Key="FilterComboBoxStyle"
               TargetType="{x:Type ComboBox}">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

        <!-- ========================================================= -->
        <!-- ListView                                                    -->
        <!-- ========================================================= -->

        <Style x:Key="InvoiceListViewStyle"
               TargetType="{x:Type ListView}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

        </Style>

        <Style x:Key="HiddenGridViewColumnHeaderStyle"
               TargetType="{x:Type GridViewColumnHeader}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

        </Style>

        <Style TargetType="{x:Type ListViewItem}">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#F3F4F6"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ListViewItem}">

                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>

                                <GridViewRowPresenter
                                    Content="{TemplateBinding Content}"
                                    Columns="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Path=View.Columns}"
                                    Margin="14,12"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#F8FAFC"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#EFF6FF"/>

                                <Setter TargetName="RowBorder"
                                        Property="BorderBrush"
                                        Value="#DBEAFE"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- SIDEBAR                                                   -->
        <!-- ========================================================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Branding -->

                <Border Grid.Row="0"
                        Padding="24,26,24,24">

                    <StackPanel>

                        <Image Source="/NOQTA.Invoice.Desktop;component/Resources/Images/NoqtaHeaderLogo.jpg"
                               Height="58"
                               Width="158"
                               HorizontalAlignment="Left"
                               Stretch="Uniform"/>

                        <TextBlock Text="INVOICE MANAGEMENT"
                                   Margin="2,12,0,0"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>


                <!-- Navigation -->

                <StackPanel Grid.Row="1"
                            Margin="16,8,16,16">


                    <TextBlock Text="WORKSPACE"
                               Foreground="{StaticResource SidebarMutedTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="12,0,0,8"/>


                    <Button x:Name="InvoicesNavigationButton"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="InvoicesNavigationButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Invoices"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="CustomersNavigationButton"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="CustomersNavigationButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Customers"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="CompanyProfileNavigationButton"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="CompanyProfileNavigationButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Company Profile"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Border Height="1"
                            Background="#374151"
                            Margin="12,22,12,20"/>


                    <TextBlock Text="ACTIONS"
                               Foreground="{StaticResource SidebarMutedTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="12,0,0,8"/>


                    <Button x:Name="NewInvoiceButton"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="NewInvoiceButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="New Invoice"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="NewCustomerButton"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="NewCustomerButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#xE8FA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="New Customer"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <!-- Footer -->

                <Border Grid.Row="2"
                        BorderBrush="#374151"
                        BorderThickness="0,1,0,0"
                        Padding="24,16">

                    <StackPanel>

                        <TextBlock Text="NOQTA AGENCY"
                                   Foreground="#F9FAFB"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Invoice Workspace"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- CONTENT WORKSPACE                                          -->
        <!-- ========================================================= -->

        <Grid Grid.Column="1"
              Background="{StaticResource PageBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Top Bar -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="30,0">

                <Grid>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="NOQTA AGENCY"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Professional invoice management"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <TextBlock Text="Invoice Management"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"/>

                </Grid>

            </Border>


            <!-- Main Workspace -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="30">

                    <!-- ================================================= -->
                    <!-- CUSTOMERS VIEW                                    -->
                    <!-- ================================================= -->

                    <Grid x:Name="CustomersView"
                          Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Customers"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Manage your invoice customers"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="13"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="18,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="CustomerSearchTextBox"
                                                 Grid.Column="0"
                                                 MinWidth="260"
                                                 Height="38"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 TextChanged="CustomerSearchTextBox_TextChanged"
                                                 ToolTip="Search by customer name, email, or type"
                                                 AutomationProperties.Name="Customer search"/>

                                        <ComboBox x:Name="CustomerStatusFilterComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="170"
                                                  Height="38"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Style="{StaticResource FilterComboBoxStyle}"
                                                  SelectionChanged="CustomerStatusFilterComboBox_SelectionChanged"
                                                  ToolTip="Filter customers by status"
                                                  AutomationProperties.Name="Customer status filter"/>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="CUSTOMERS"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CustomerCountTextBlock"
                                                       Text="0"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,1,0,0"
                                                       ToolTip="Total customers loaded in the register"/>
                                            <TextBlock x:Name="SelectedCustomerTextBlock"
                                                       Text="No customer selected"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="Currently selected customer"/>
                                        </StackPanel>

                                        <Button x:Name="RefreshCustomersButton"
                                                Grid.Column="3"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="RefreshCustomersButton_Click"
                                                ToolTip="Reload the customer register"
                                                AutomationProperties.Name="Refresh customers">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Margin="0,0,7,0"/>
                                                <TextBlock Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="32,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="NAME"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="TYPE"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="EMAIL"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="STATUS"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <ListView x:Name="CustomersListView"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Margin="0"
                                              SelectionMode="Single"
                                              SelectionChanged="CustomersListView_SelectionChanged"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.View>
                                            <GridView ColumnHeaderContainerStyle="{StaticResource HiddenGridViewColumnHeaderStyle}">
                                                <GridViewColumn Header="Name"
                                                                Width="260"
                                                                DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="Type"
                                                                Width="160"
                                                                DisplayMemberBinding="{Binding Type}"/>
                                                <GridViewColumn Header="Email"
                                                                Width="260"
                                                                DisplayMemberBinding="{Binding Email}"/>
                                                <GridViewColumn Header="Status"
                                                                Width="120">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="10"
                                                                    Padding="9,3"
                                                                    HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="Background"
                                                                                Value="{StaticResource DangerBackgroundBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{StaticResource SuccessBackgroundBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{StaticResource DangerBrush}"/>
                                                                            <Setter Property="Text"
                                                                                    Value="Inactive"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                                             Value="True">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="{StaticResource SuccessBrush}"/>
                                                                                    <Setter Property="Text"
                                                                                            Value="Active"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <Border x:Name="CustomerDetailsPanel"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20"
                                            Margin="18,12"
                                            Visibility="Collapsed">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Customer Details"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock x:Name="CustomerDetailsSubtitleTextBlock"
                                                               Text="Selected customer"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border x:Name="CustomerDetailsStatusBorder"
                                                        Grid.Column="1"
                                                        Background="{StaticResource DangerBackgroundBrush}"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource DangerBackgroundBrush}"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource SuccessBackgroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock x:Name="CustomerDetailsStatusTextBlock"
                                                               Text="Inactive"
                                                               FontSize="11"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource DangerBrush}"/>

                                                                <Setter Property="Text"
                                                                        Value="Inactive"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource SuccessBrush}"/>
                                                                        <Setter Property="Text"
                                                                                Value="Active"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <Button x:Name="EditCustomerButton"
                                                        Grid.Column="3"
                                                        Content="Edit Customer"
                                                        MinWidth="118"
                                                        Height="34"
                                                        Padding="14,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Edit the selected customer"
                                                        Click="EditCustomerButton_Click"
                                                        IsEnabled="False"/>

                                                <Button x:Name="DeactivateCustomerButton"
                                                        Grid.Column="5"
                                                        Content="Deactivate"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Padding="14,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Deactivate the selected customer"
                                                        Click="DeactivateCustomerButton_Click"/>

                                                <Button x:Name="ReactivateCustomerButton"
                                                        Grid.Column="5"
                                                        Content="Reactivate"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Padding="14,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Reactivate the selected customer"
                                                        Click="ReactivateCustomerButton_Click"/>

                                            </Grid>

                                            <!-- Customer fields -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="NAME"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock x:Name="CustomerDetailsNameTextBlock"
                                                               Text="-"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Margin="0,5,20,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="TYPE"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock x:Name="CustomerDetailsTypeTextBlock"
                                                               Text="-"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13"
                                                               Margin="0,5,20,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="EMAIL"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock x:Name="CustomerDetailsEmailTextBlock"
                                                               Text="-"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13"
                                                               Margin="0,5,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Selection information -->
                                            <Border Grid.Row="4"
                                                    Background="#F9FAFB"
                                                    CornerRadius="6"
                                                    Padding="12">
                                                <TextBlock x:Name="CustomerDetailsSelectionTextBlock"
                                                           Text="Customer selected from the register."
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="EmptyCustomersPanel"
                                            Background="White"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="EmptyCustomersTextBlock"
                                                       Text="No customers found."
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CustomerEmptyStateHintTextBlock"
                                                       Text="Create your first customer to start managing your register."
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="LoadingCustomersPanel"
                                            Background="White"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Background="#EFF6FF"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE895;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock x:Name="LoadingCustomersTextBlock"
                                                       Text="Loading customers..."
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,12,0,0"/>

                                            <TextBlock Text="Please wait while the customer register is loaded."
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ================================================= -->
                    <!-- INVOICES VIEW                                     -->
                    <!-- ================================================= -->

                    <Grid x:Name="InvoicesView">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Page Heading -->

                        <Grid Grid.Row="0">

                            <StackPanel>

                                <TextBlock Text="Invoices"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Monitor invoices and quotes across your workspace"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="13"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <Button x:Name="HeaderNewInvoiceButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewInvoiceButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,0,7,0"/>

                                    <TextBlock Text="New Invoice"/>

                                </StackPanel>

                            </Button>

                        </Grid>


                        <!-- KPI Cards -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Total invoices -->

                            <Border Grid.Column="0"
                                    Style="{StaticResource KpiCardBorderStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="TOTAL INVOICES"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="TotalInvoicesKpiTextBlock"
                                                   Text="0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="All loaded invoices"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="9"
                                            Background="#EFF6FF"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- Draft -->

                            <Border Grid.Column="2"
                                    Style="{StaticResource KpiCardBorderStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="DRAFT"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="DraftInvoicesKpiTextBlock"
                                                   Text="0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Invoices in draft"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="9"
                                            Background="#FEF3C7"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="&#xE70F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- Paid -->

                            <Border Grid.Column="4"
                                    Style="{StaticResource KpiCardBorderStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="PAID"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="PaidInvoicesKpiTextBlock"
                                                   Text="0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Paid invoices"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="9"
                                            Background="{StaticResource SuccessBackgroundBrush}"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- Total value -->

                            <Border Grid.Column="6"
                                    Style="{StaticResource KpiCardBorderStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="TOTAL VALUE"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="TotalInvoiceValueKpiTextBlock"
                                                   Text="0.00"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="23"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Loaded invoice values"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="9"
                                            Background="#F3E8FF"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="&#xE8C7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="#7E22CE"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- Search / Filters -->

                        <Border Grid.Row="4"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Grid Grid.Column="0">

                                    <TextBox x:Name="InvoiceSearchTextBox"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             TextChanged="InvoiceSearchTextBox_TextChanged"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Search by invoice number or customer"/>

                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="14"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <TextBlock Text="Search invoices..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               Margin="36,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                </Grid>


                                <ComboBox x:Name="InvoiceStatusFilterComboBox"
                                          Grid.Column="2"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          SelectionChanged="InvoiceStatusFilterComboBox_SelectionChanged"
                                          VerticalContentAlignment="Center"/>


                                <Button x:Name="RefreshInvoicesButton"
                                        Grid.Column="4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshInvoicesButton_Click">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Margin="0,0,7,0"/>

                                        <TextBlock Text="Refresh"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>


                        <!-- Invoice Register -->

                        <Border Grid.Row="6"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>


                                <!-- Table Header -->

                                <Border Grid.Row="0"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <Grid Margin="18,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.05*"/>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1.25*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="INVOICE"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="CUSTOMER"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="TYPE"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="STATUS"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="TOTAL"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="5"
                                                   Text="CREATED"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>

                                    </Grid>

                                </Border>


                                <!-- Table -->

                                <Grid Grid.Row="1">

                                    <ListView x:Name="InvoicesListView"
                                              Style="{StaticResource InvoiceListViewStyle}"
                                              MouseDoubleClick="InvoicesListView_MouseDoubleClick">

                                        <ListView.View>

                                            <GridView ColumnHeaderContainerStyle="{StaticResource HiddenGridViewColumnHeaderStyle}">

                                                <GridViewColumn Header="Invoice"
                                                                Width="150">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding InvoiceNumber}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>


                                                <GridViewColumn Header="Customer"
                                                                Width="230">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding CustomerName}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>


                                                <GridViewColumn Header="Type"
                                                                Width="100">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding InvoiceType}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>


                                                <GridViewColumn Header="Status"
                                                                Width="120">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <Border x:Name="StatusBadge"
                                                                    Style="{StaticResource InvoiceStatusBadgeStyle}">

                                                                <TextBlock x:Name="StatusText"
                                                                           Text="{Binding Status}"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"/>

                                                            </Border>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>


                                                <GridViewColumn Header="Total"
                                                                Width="145">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Total, StringFormat={}{0:N2}}"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>


                                                <GridViewColumn Header="Created"
                                                                Width="160">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="12"
                                                                       Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>

                                            </GridView>

                                        </ListView.View>

                                    </ListView>


                                    <!-- Empty state -->

                                    <StackPanel x:Name="EmptyInvoicesPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Border Width="54"
                                                Height="54"
                                                CornerRadius="27"
                                                Background="#F3F4F6"
                                                HorizontalAlignment="Center">

                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="21"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>

                                        <TextBlock x:Name="EmptyInvoicesTextBlock"
                                                   Text="No invoices found."
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14,0,0"/>

                                        <TextBlock x:Name="InvoiceEmptyStateHintTextBlock"
                                                   Text="Create your first invoice to start managing your register."
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>