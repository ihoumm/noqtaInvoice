<Window x:Class="NOQTA.Invoice.Desktop.Customers.EditCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Customer"
        Height="680"
        Width="760"
        MinHeight="620"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="28,22">

            <StackPanel>
                <TextBlock Text="Edit Customer"
                           Foreground="#111827"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Update the customer information."
                           Foreground="#6B7280"
                           FontSize="13"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28,24">

                <!-- Customer type -->
                <TextBlock Text="CUSTOMER TYPE"
                           Foreground="#6B7280"
                           FontSize="10"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="CustomerTypeComboBox"
                          Height="38"
                          Margin="0,7,0,20"
                          Padding="10,0">

                    <ComboBoxItem Content="Individual"/>
                    <ComboBoxItem Content="Entrepreneur"/>
                    <ComboBoxItem Content="Company"/>
                    <ComboBoxItem Content="Freelancer"/>
                    <ComboBoxItem Content="NonProfit"/>
                    <ComboBoxItem Content="Government"/>
                </ComboBox>

                <!-- Name -->
                <TextBlock Text="NAME"
                           Foreground="#6B7280"
                           FontSize="10"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="NameTextBox"
                         Height="38"
                         Margin="0,7,0,20"
                         Padding="10,0"/>

                <!-- Email -->
                <TextBlock Text="EMAIL"
                           Foreground="#6B7280"
                           FontSize="10"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         Margin="0,7,0,20"
                         Padding="10,0"/>

                <!-- Address -->
                <TextBlock Text="ADDRESS"
                           Foreground="#6B7280"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="StreetTextBox"
                         Height="38"
                         Margin="0,0,0,12"
                         Padding="10,0"
                         ToolTip="Street"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CityTextBox"
                             Grid.Column="0"
                             Height="38"
                             Padding="10,0"
                             ToolTip="City"/>

                    <TextBox x:Name="PostalCodeTextBox"
                             Grid.Column="2"
                             Height="38"
                             Padding="10,0"
                             ToolTip="Postal Code"/>
                </Grid>

                <TextBox x:Name="CountryTextBox"
                         Height="38"
                         Margin="0,0,0,20"
                         Padding="10,0"
                         ToolTip="Country"/>

                <!-- Validation -->
                <TextBlock x:Name="ValidationTextBlock"
                           Foreground="#DC2626"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="28,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="100"
                        Height="36"
                        IsCancel="True"/>

                <Button Grid.Column="3"
                        x:Name="SaveCustomerButton"
                        Content="Save Changes"
                        Width="125"
                        Height="36"
                        IsDefault="True"
                        Click="SaveCustomerButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>