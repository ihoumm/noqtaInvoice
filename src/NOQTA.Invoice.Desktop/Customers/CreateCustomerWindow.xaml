<Window x:Class="NOQTA.Invoice.Desktop.Customers.CreateCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Customer"
        Height="680"
        Width="760"
        MinHeight="620"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="New Customer"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Enter the customer information"
                       Margin="0,6,0,0"
                       Foreground="#6B7280"
                       FontSize="13"/>

        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Customer Type -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Customer Type"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="CustomerTypeComboBox"
                              Margin="0,8,0,0"
                              Height="36"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Individual"/>
                        <ComboBoxItem Content="Entrepreneur"/>
                        <ComboBoxItem Content="Company"/>
                        <ComboBoxItem Content="Freelancer"/>
                        <ComboBoxItem Content="NonProfit"/>
                        <ComboBoxItem Content="Government"/>
                    </ComboBox>

                </StackPanel>

                <!-- Name -->
                <StackPanel Grid.Row="2">

                    <TextBlock Text="Name"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="NameTextBox"
                             Margin="0,8,0,0"
                             Height="36"/>

                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="4">

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="EmailTextBox"
                             Margin="0,8,0,0"
                             Height="36"/>

                </StackPanel>

                <!-- Address -->
                <Grid Grid.Row="6">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Address"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Street"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                            <TextBox x:Name="StreetTextBox"
                                     Margin="0,6,0,0"
                                     Height="36"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="City"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                            <TextBox x:Name="CityTextBox"
                                     Margin="0,6,0,0"
                                     Height="36"/>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Postal Code"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                            <TextBox x:Name="PostalCodeTextBox"
                                     Margin="0,6,0,0"
                                     Height="36"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Country"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                            <TextBox x:Name="CountryTextBox"
                                     Margin="0,6,0,0"
                                     Height="36"/>

                        </StackPanel>

                    </Grid>

                </Grid>

                <!-- Future validation area -->
                <TextBlock Grid.Row="8"
                           x:Name="ValidationTextBlock"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"/>

            </Grid>

        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="4"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="100"
                        Margin="0,0,12,0"
                        IsCancel="True"/>

                <Button Content="Create Customer"
                        Width="140"
                        IsDefault="True"
                        Click="CreateCustomerButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>